<templates xml:space="preserve">

    <t t-name="report_studio.Versions">
        <div class="o_rs_section_title"><i class="fa fa-history me-1"/>Versions</div>
        <input class="form-control form-control-sm mb-2" placeholder="Version comment"
               title="Comment of the next saved version" t-model="state.comment"/>
        <t t-foreach="state.versions" t-as="v" t-key="v.id">
            <div class="d-flex align-items-center gap-1 mb-1 o_rs_version">
                <span class="flex-grow-1 min-w-0">
                    v<t t-esc="v.version_no"/>
                    <t t-if="v.is_active"><span class="badge bg-success ms-1">active</span></t>
                    <small class="text-muted d-block text-truncate" t-att-title="v.comment or ''"><t t-esc="v.comment or ''"/></small>
                </span>
                <button class="btn btn-sm btn-outline-secondary" t-att-data-id="v.id" t-on-click="restoreVersion">Restore</button>
                <button class="btn btn-sm btn-outline-secondary" t-att-data-id="v.id" t-on-click="copyVersion">Copy</button>
            </div>
        </t>
        <input class="form-control form-control-sm mt-1" placeholder="Name of the copy" t-model="state.copyName"/>
    </t>

    <!-- Font controls: size, bold, italic, underline.
         Parameters: font (block object), title (group label). -->
    <t t-name="report_studio.FontControls">
        <div class="o_rs_font mt-2" t-att-data-font="title">
            <label class="form-label small text-muted mb-1"><t t-esc="title"/></label>
            <div class="d-flex gap-1">
                <select class="form-select form-select-sm o_rs_font_size" title="Size (pt)"
                        t-on-change="(ev) => this.onFontSize(font, ev)">
                    <option value="" t-att-selected="!font.size">Layout default</option>
                    <t t-foreach="fontSizes" t-as="size" t-key="size">
                        <option t-att-value="size" t-att-selected="font.size === size"><t t-esc="size"/> pt</option>
                    </t>
                </select>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" title="Bold" data-style="bold"
                            t-attf-class="btn btn-outline-secondary {{ font.bold ? 'active' : '' }}"
                            t-on-click="() => this.toggleFont(font, 'bold')"><i class="fa fa-bold"/></button>
                    <button type="button" title="Italic" data-style="italic"
                            t-attf-class="btn btn-outline-secondary {{ font.italic ? 'active' : '' }}"
                            t-on-click="() => this.toggleFont(font, 'italic')"><i class="fa fa-italic"/></button>
                    <button type="button" title="Underline" data-style="underline"
                            t-attf-class="btn btn-outline-secondary {{ font.underline ? 'active' : '' }}"
                            t-on-click="() => this.toggleFont(font, 'underline')"><i class="fa fa-underline"/></button>
                </div>
            </div>
        </div>
    </t>

    <!-- Text alignment. Parameter: target (block). No active button = as the
         container; the innermost block wins. -->
    <t t-name="report_studio.AlignControls">
        <div class="o_rs_align mt-2">
            <label class="form-label small text-muted mb-1 d-block">Alignment</label>
            <div class="btn-group btn-group-sm" role="group">
                <t t-foreach="alignments" t-as="al" t-key="al[0]">
                    <button type="button" t-att-title="al[1]" t-att-data-align="al[0]"
                            t-attf-class="btn btn-outline-secondary {{ target.align === al[0] ? 'active' : '' }}"
                            t-on-click="() => this.setAlign(target, al[0])"><i t-attf-class="fa {{ al[2] }}"/></button>
                </t>
            </div>
            <small class="text-muted ms-2" t-if="!target.align">as the container</small>
        </div>
    </t>

    <!-- Inner margins in mm. Parameter: margins (block object). -->
    <t t-name="report_studio.MarginControls">
        <div class="o_rs_margins mt-3">
            <div class="fw-bold mb-1"><i class="fa fa-arrows-alt me-1"/>Margins (mm)</div>
            <div class="row g-1">
                <t t-foreach="marginSides" t-as="side" t-key="side[0]">
                    <div class="col-6">
                        <label class="form-label small text-muted mb-0"><t t-esc="side[1]"/></label>
                        <input type="number" min="0" max="100" step="0.5" class="form-control form-control-sm"
                               t-att-data-side="side[0]" t-att-value="margins[side[0]]"
                               t-on-change="(ev) => this.onMargin(margins, side[0], ev)"/>
                    </div>
                </t>
            </div>
        </div>
    </t>

    <t t-name="report_studio.PreviewDialog">
        <Dialog title.translate="PDF Preview" size="'xl'" bodyClass="'o_rs_preview_dialog'">
            <div class="d-flex align-items-center gap-2 mb-2">
                <label class="mb-0">Record</label>
                <select class="form-select w-auto" t-on-change="onRecordChange">
                    <t t-foreach="props.records" t-as="rec" t-key="rec.id">
                        <option t-att-value="rec.id" t-att-selected="rec.id === state.recordId"><t t-esc="rec.display_name"/></option>
                    </t>
                </select>
                <button class="btn btn-secondary" t-on-click="load" t-att-disabled="state.loading">
                    <i class="fa fa-refresh me-1"/>Refresh preview
                </button>
                <span t-if="state.loading" class="text-muted"><i class="fa fa-spinner fa-spin me-1"/>Generating the PDF…</span>
            </div>
            <iframe t-if="state.url" t-att-src="state.url" class="o_rs_preview_frame w-100 border"/>
            <div t-elif="state.error" class="alert alert-danger"><t t-esc="state.error"/></div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="props.close">Close</button>
            </t>
        </Dialog>
    </t>

    <!-- Toolbar button not available yet ("Coming soon"). -->
    <t t-name="report_studio.TopButtonSoon">
        <button class="btn o_rs_tb_btn btn-outline-secondary" disabled="disabled" title="Coming soon">
            <i t-attf-class="fa {{ icon }}"/>
            <span><t t-esc="label"/></span>
        </button>
    </t>

    <t t-name="report_studio.App">
        <div class="o_rs_app d-flex flex-column h-100">

            <!-- NEW REPORT -->
            <t t-if="state.view === 'new'">
                <div class="d-flex align-items-center gap-2 p-2 border-bottom">
                    <button class="btn btn-outline-secondary" t-on-click="showList">Saved Layouts</button>
                    <span class="fw-bold">New Report</span>
                </div>
                <div class="p-4" style="max-width: 720px">
                    <div class="row mb-3 align-items-center">
                        <label class="col-3 col-form-label">Name</label>
                        <div class="col-9">
                            <input class="form-control" placeholder="Report name" t-model="state.newName"/>
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label class="col-3 col-form-label">Model</label>
                        <div class="col-9">
                            <select class="form-select" t-model="state.newModel" t-att-disabled="state.newSource ? true : false">
                                <option value="">— choose the model —</option>
                                <t t-foreach="state.models" t-as="m" t-key="m.id">
                                    <option t-att-value="m.model"><t t-esc="m.model"/> — <t t-esc="m.name"/></option>
                                </t>
                            </select>
                            <small class="text-muted">For a copy the model is the one of the starting document.</small>
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label class="col-3 col-form-label">Starting Document</label>
                        <div class="col-9">
                            <select class="form-select" t-on-change="onNewSourceChange">
                                <option value="">— none: empty blocks report —</option>
                                <optgroup t-if="nativeSources.length" label="Odoo Documents">
                                    <t t-foreach="nativeSources" t-as="s" t-key="s.key">
                                        <option t-att-value="s.key"><t t-esc="s.label"/></option>
                                    </t>
                                </optgroup>
                                <optgroup t-if="studioSources.length" label="Report Studio">
                                    <t t-foreach="studioSources" t-as="s" t-key="s.key">
                                        <option t-att-value="s.key"><t t-esc="s.label"/></option>
                                    </t>
                                </optgroup>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <label class="col-3 col-form-label">Structure</label>
                        <div class="col-9 text-muted">
                            The one configured in Odoo (Settings → Companies → Document Layout). It applies to all documents.
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button class="btn btn-primary" t-on-click="onOpenVisualEditor">Open Visual Editor</button>
                        <button class="btn btn-secondary" t-on-click="showList">Discard</button>
                    </div>
                </div>
            </t>

            <!-- EDITOR -->
            <t t-else="">
                <div class="o_rs_topbar d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                    <button class="btn btn-outline-secondary" t-on-click="backToList">← Saved Layouts</button>
                    <span class="o_rs_report_name fw-bold"><t t-esc="state.reportName"/></span>
                    <span class="badge text-bg-light border"><t t-esc="state.modelName"/></span>
                    <span class="badge bg-secondary"><t t-if="state.mode === 'qweb'">Free QWeb</t><t t-else="">Blocks</t></span>
                    <span t-if="state.dirty" class="text-warning small">Unsaved changes</span>

                    <div class="ms-auto d-flex align-items-center gap-2">
                        <div class="form-check form-switch mb-0 o_rs_active_toggle" title="Off = archived report">
                            <input class="form-check-input" type="checkbox" id="o_rs_active"
                                   t-att-checked="state.active" t-att-disabled="!state.canWrite"
                                   t-on-change="onToggleActive"/>
                            <label class="form-check-label" for="o_rs_active">Active</label>
                        </div>
                        <div t-if="state.mode !== 'qweb'" class="input-group input-group-sm w-auto o_rs_lang"
                             title="Language of the texts you are editing; the page in the center shows it">
                            <span class="input-group-text"><i class="fa fa-language"/></span>
                            <select class="form-select o_rs_lang_select" t-on-change="onEditLang">
                                <t t-foreach="langOptions" t-as="opt" t-key="opt.code">
                                    <option t-att-value="opt.code" t-att-selected="opt.code === state.editLang">
                                        <t t-esc="opt.label"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <select class="form-select w-auto o_rs_record_select" title="Record used for the page data"
                                t-on-change="onRecordChange">
                            <t t-foreach="state.records" t-as="rec" t-key="rec.id">
                                <option t-att-value="rec.id" t-att-selected="rec.id === state.recordId">
                                    <t t-esc="rec.display_name"/>
                                </option>
                            </t>
                        </select>
                        <t t-call="report_studio.TopButtonSoon">
                            <t t-set="icon" t-value="'fa-th-large'"/><t t-set="label" t-value="soonButtons.template"/>
                        </t>
                        <t t-call="report_studio.TopButtonSoon">
                            <t t-set="icon" t-value="'fa-bookmark-o'"/><t t-set="label" t-value="soonButtons.saveTemplate"/>
                        </t>
                        <button class="btn o_rs_tb_btn btn-outline-secondary o_rs_btn_preview" title="PDF Preview"
                                t-att-disabled="!state.recordId" t-on-click="preview">
                            <i class="fa fa-eye"/><span>Preview</span>
                        </button>
                        <t t-call="report_studio.TopButtonSoon">
                            <t t-set="icon" t-value="'fa-print'"/><t t-set="label" t-value="soonButtons.testPrint"/>
                        </t>
                        <t t-call="report_studio.TopButtonSoon">
                            <t t-set="icon" t-value="'fa-question-circle'"/><t t-set="label" t-value="soonButtons.help"/>
                        </t>
                        <button class="btn o_rs_tb_btn btn-primary o_rs_btn_save" title="Save as a new version"
                                t-att-disabled="!state.reportId" t-on-click="saveVersion">
                            <i class="fa fa-save"/><span>Save</span>
                        </button>
                    </div>
                </div>

                <div class="o_rs_body d-flex flex-grow-1">

                    <!-- LEFT: tools and versions -->
                    <div class="o_rs_left d-flex flex-column border-end">
                        <div t-if="state.mode !== 'qweb'" class="o_rs_toolbox flex-grow-1 overflow-auto p-2">
                            <div class="o_rs_section_title"><i class="fa fa-th-large me-1"/>Blocks</div>
                            <t t-foreach="blockGroups" t-as="group" t-key="group.label">
                                <div class="o_rs_group_label"><t t-esc="group.label"/></div>
                                <t t-foreach="group.items" t-as="item" t-key="item.type">
                                    <button class="o_rs_tool btn btn-link" t-att-data-type="item.type" t-on-click="onAddBlock"
                                            draggable="true" t-on-dragstart="(ev) => this.onToolDragStart(ev, item.type)"
                                            t-on-dragend="endDrag">
                                        <i t-attf-class="fa {{ item.icon }} fa-fw me-2"/><t t-esc="item.label"/>
                                    </button>
                                </t>
                            </t>
                            <div class="small text-muted mt-2">
                                Click: the block goes inside the selected one (Section, Column, Condition) or after it. Or drag it into the page.
                            </div>
                        </div>
                        <div t-attf-class="o_rs_versions overflow-auto p-2 {{ state.mode !== 'qweb' ? 'border-top' : 'flex-grow-1' }}">
                            <t t-call="report_studio.Versions"/>
                        </div>
                    </div>

                    <!-- CENTER: page -->
                    <t t-if="state.mode === 'qweb'">
                        <div class="flex-grow-1 p-2 d-flex flex-column min-w-0">
                            <div class="small text-muted mb-1">QWeb template. Layout and style come from Odoo.</div>
                            <textarea class="form-control font-monospace flex-grow-1" t-model="state.qwebText" t-on-input="markDirty"/>
                        </div>
                    </t>
                    <div t-else="" class="o_rs_canvas flex-grow-1 min-w-0 position-relative">
                        <div t-if="state.canvasError" class="alert alert-warning m-2 o_rs_canvas_error"><t t-esc="state.canvasError"/></div>
                        <div t-if="!state.definition.children.length" class="o_rs_canvas_hint text-muted">
                            Empty page: add a block from the left column.
                        </div>
                        <span t-if="state.canvasLoading" class="o_rs_canvas_loading text-muted small">
                            <i class="fa fa-spinner fa-spin"/>
                        </span>
                        <iframe t-ref="canvas" class="o_rs_canvas_frame"/>
                    </div>

                    <!-- RIGHT: properties -->
                    <div class="o_rs_props p-3 border-start overflow-auto">
                        <div class="o_rs_section_title"><i class="fa fa-cog me-1"/>Properties</div>
                        <t t-if="state.mode === 'qweb'">
                            <div class="text-muted">Free QWeb mode: the template is edited in the center.</div>
                        </t>
                        <t t-else="">
                            <div t-if="isTranslating" class="alert alert-info py-2 small o_rs_translating">
                                <i class="fa fa-language me-1"/><t t-esc="translatingNotice"/>
                            </div>
                            <t t-if="selected">
                                <div class="o_rs_props_title mb-2"><t t-esc="blockLabels[selected.type] or selected.type"/></div>

                                <t t-if="selected.type === 'section'">
                                    <!-- Label: bar on top of the section, translatable. -->
                                    <div class="o_rs_section_label">
                                        <label class="form-label">Label</label>
                                        <input class="form-control o_rs_section_title_text"
                                               t-att-placeholder="trPlaceholder(selected.title, 'text', sectionLabelPlaceholder) or sectionLabelPlaceholder"
                                               t-att-value="trValue(selected.title, 'text')"
                                               t-on-input="(ev) => this.setTr(selected.title, 'text', ev)"/>
                                        <div class="d-flex align-items-center gap-3 mt-2">
                                            <t t-foreach="[['background', 'Background'], ['color', 'Text']]" t-as="c" t-key="c[0]">
                                                <div class="d-flex align-items-center gap-1" t-att-data-color="c[0]">
                                                    <small class="text-muted" t-if="c[0] === 'background'">Background</small>
                                                    <small class="text-muted" t-else="">Text color</small>
                                                    <input type="color" class="form-control form-control-color form-control-sm o_rs_title_color"
                                                           t-att-value="selected.title[c[0]] or (c[0] === 'background' ? '#ffffff' : '#000000')"
                                                           t-on-input="(ev) => this.onTitleColor(selected.title, c[0], ev)"/>
                                                    <button t-if="selected.title[c[0]]" type="button" class="btn btn-sm btn-link px-1 o_rs_clear_color"
                                                            title="No color" t-on-click="() => this.clearTitleColor(selected.title, c[0])">×</button>
                                                    <small t-else="" class="text-muted fst-italic">none</small>
                                                </div>
                                            </t>
                                        </div>
                                        <t t-call="report_studio.AlignControls"><t t-set="target" t-value="selected.title"/></t>
                                        <t t-call="report_studio.FontControls">
                                            <t t-set="font" t-value="selected.title.font"/><t t-set="title" t-value="fontTitles.sectionLabel"/>
                                        </t>
                                    </div>

                                    <!-- Borders, like the cell borders of a spreadsheet. -->
                                    <div class="o_rs_borders mt-3">
                                        <div class="fw-bold mb-1"><i class="fa fa-square-o me-1"/>Borders</div>
                                        <div class="btn-group btn-group-sm mb-2" role="group">
                                            <button type="button" class="btn btn-outline-secondary o_rs_border_all" title="All borders"
                                                    t-on-click="() => this.setBorderSides(selected.border, ['top', 'right', 'bottom', 'left'])">
                                                <i class="fa fa-square-o"/>
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary o_rs_border_none" title="No border"
                                                    t-on-click="() => this.setBorderSides(selected.border, [])">
                                                <i class="fa fa-ban"/>
                                            </button>
                                            <t t-foreach="marginSides" t-as="side" t-key="side[0]">
                                                <button type="button" t-att-title="side[1]" t-att-data-side="side[0]"
                                                        t-attf-class="btn btn-outline-secondary o_rs_border_side {{ selected.border.sides.includes(side[0]) ? 'active' : '' }}"
                                                        t-on-click="() => this.toggleBorderSide(selected.border, side[0])">
                                                    <t t-esc="side[1]"/>
                                                </button>
                                            </t>
                                        </div>
                                        <div class="d-flex gap-1 align-items-center">
                                            <select class="form-select form-select-sm o_rs_border_style" title="Border line style"
                                                    t-on-change="(ev) => this.onBorder(selected.border, 'style', ev)">
                                                <t t-foreach="borderStyles" t-as="st" t-key="st[0]">
                                                    <option t-att-value="st[0]" t-att-selected="selected.border.style === st[0]"><t t-esc="st[1]"/></option>
                                                </t>
                                            </select>
                                            <select class="form-select form-select-sm o_rs_border_width" style="width: 5.5rem; flex: 0 0 5.5rem" title="Thickness"
                                                    t-on-change="(ev) => this.onBorder(selected.border, 'width', ev)">
                                                <t t-foreach="borderWidths" t-as="px" t-key="px">
                                                    <option t-att-value="px" t-att-selected="selected.border.width === px"><t t-esc="px"/> px</option>
                                                </t>
                                            </select>
                                            <input type="color" class="form-control form-control-color form-control-sm o_rs_border_color"
                                                   title="Border line color" t-att-value="selected.border.color"
                                                   t-on-input="(ev) => this.onBorder(selected.border, 'color', ev)"/>
                                        </div>
                                        <small class="text-muted" t-if="selected.border.style === 'double' and selected.border.width &lt; 3">
                                            A double line needs at least 3 px to show both lines.
                                        </small>
                                    </div>

                                    <!-- CSS classes: presets from the menu, or written by hand. -->
                                    <div class="o_rs_css mt-3">
                                        <label class="form-label">CSS Class</label>
                                        <div class="d-flex flex-wrap gap-1 mb-1">
                                            <t t-foreach="sectionClasses(selected)" t-as="cls" t-key="cls">
                                                <span class="badge text-bg-light border o_rs_css_chip" t-att-data-class="cls">
                                                    <t t-esc="cssPresetLabel(cls)"/>
                                                    <a href="#" class="ms-1 text-danger" title="Remove"
                                                       t-on-click.prevent="() => this.removeCssClass(selected, cls)">×</a>
                                                </span>
                                            </t>
                                        </div>
                                        <select class="form-select form-select-sm o_rs_css_add" t-on-change="(ev) => this.addCssClass(selected, ev)">
                                            <option value="">+ Add a style…</option>
                                            <t t-foreach="availableCssPresets(selected)" t-as="preset" t-key="preset[0]">
                                                <option t-att-value="preset[0]"><t t-esc="preset[1]"/></option>
                                            </t>
                                        </select>
                                        <input class="form-control form-control-sm mt-1 font-monospace o_rs_css_text" t-model="selected.class"
                                               t-on-input="markDirty" title="Classes separated by a space (Bootstrap classes work too)"/>
                                    </div>

                                    <t t-call="report_studio.AlignControls"><t t-set="target" t-value="selected"/></t>
                                    <t t-call="report_studio.MarginControls"><t t-set="margins" t-value="selected.margins"/></t>
                                </t>

                                <t t-if="selected.type === 'columns'">
                                    <label class="form-label">Number of Columns</label>
                                    <select class="form-select o_rs_columns_count" t-on-change="onColumnsCount">
                                        <t t-foreach="columnCounts" t-as="n" t-key="n">
                                            <option t-att-value="n" t-att-selected="selected.children.length === n"><t t-esc="n"/></option>
                                        </t>
                                    </select>
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input o_rs_columns_divider" type="checkbox" id="o_rs_divider"
                                               t-model="selected.divider" t-on-change="markDirty"/>
                                        <label class="form-check-label" for="o_rs_divider">Vertical line between the columns</label>
                                    </div>
                                    <t t-call="report_studio.AlignControls"><t t-set="target" t-value="selected"/></t>
                                    <div class="small text-muted mt-2">
                                        To add blocks or set the margins of a column, click inside the column in the page.
                                    </div>
                                    <t t-call="report_studio.MarginControls"><t t-set="margins" t-value="selected.margins"/></t>
                                </t>

                                <t t-if="selected.type === 'column'">
                                    <div class="small text-muted">The blocks added from the left column go into this column.</div>
                                    <t t-call="report_studio.AlignControls"><t t-set="target" t-value="selected"/></t>
                                    <t t-call="report_studio.MarginControls"><t t-set="margins" t-value="selected.margins"/></t>
                                </t>

                                <t t-if="selected.type === 'separator'">
                                    <label class="form-label">Line Style</label>
                                    <select class="form-select o_rs_separator_style" t-model="selected.style" t-on-change="markDirty">
                                        <t t-foreach="separatorStyles" t-as="st" t-key="st[0]">
                                            <option t-att-value="st[0]"><t t-esc="st[1]"/></option>
                                        </t>
                                    </select>
                                    <label class="form-label mt-2">Thickness</label>
                                    <select class="form-select o_rs_separator_thickness" t-model.number="selected.thickness" t-on-change="markDirty">
                                        <t t-foreach="[1, 2, 3, 4, 5]" t-as="px" t-key="px">
                                            <option t-att-value="px"><t t-esc="px"/> px</option>
                                        </t>
                                    </select>
                                </t>

                                <t t-if="selected.type === 'spacer'">
                                    <label class="form-label">Height (mm)</label>
                                    <input type="number" min="1" max="200" step="1" class="form-control o_rs_spacer_height"
                                           t-model.number="selected.height" t-on-change="markDirty"/>
                                </t>

                                <t t-if="selected.type === 'page_break'">
                                    <div class="text-muted">In the PDF the following content starts on a new page.</div>
                                </t>

                                <t t-if="selected.type === 'text'">
                                    <label class="form-label">Text</label>
                                    <textarea class="form-control o_rs_text_content" rows="4"
                                              t-att-value="trValue(selected, 'content')"
                                              t-att-placeholder="trPlaceholder(selected, 'content')"
                                              t-on-input="(ev) => this.setTr(selected, 'content', ev)"/>
                                    <t t-call="report_studio.AlignControls"><t t-set="target" t-value="selected"/></t>
                                    <t t-call="report_studio.FontControls">
                                        <t t-set="font" t-value="selected.font"/><t t-set="title" t-value="fontTitles.font"/>
                                    </t>
                                </t>

                                <t t-if="selected.type === 'field'">
                                    <label class="form-label">Field</label>
                                    <FieldSelector value="selected.path or ''" model="state.modelName" loadFields="loadFields"
                                                   onChange="(v) => this.setPath(selected, 'path', v)" class="'o_rs_path_field'"/>
                                    <label class="form-label mt-2">Label</label>
                                    <input class="form-control o_rs_field_label"
                                           t-att-placeholder="trPlaceholder(selected, 'label', labelPlaceholder) or labelPlaceholder"
                                           t-att-value="trValue(selected, 'label')"
                                           t-on-input="(ev) => this.setTr(selected, 'label', ev)"/>
                                    <t t-call="report_studio.AlignControls"><t t-set="target" t-value="selected"/></t>
                                    <t t-call="report_studio.FontControls">
                                        <t t-set="font" t-value="selected.label_font"/><t t-set="title" t-value="fontTitles.label"/>
                                    </t>
                                    <t t-call="report_studio.FontControls">
                                        <t t-set="font" t-value="selected.font"/><t t-set="title" t-value="fontTitles.value"/>
                                    </t>
                                </t>

                                <t t-if="selected.type === 'table'">
                                    <label class="form-label">Source (one2many / many2many)</label>
                                    <FieldSelector value="selected.source or ''" model="state.modelName" loadFields="loadFields"
                                                   filter="isX2many" onChange="(v) => this.onTableSource(selected, v)" class="'o_rs_path_source'"/>
                                    <button type="button" class="btn btn-sm btn-outline-primary mt-2 o_rs_table_style_btn" t-on-click="openTableStyle">
                                        <i class="fa fa-paint-brush me-1"/>Table style: backgrounds, borders, row height…
                                    </button>
                                    <t t-call="report_studio.AlignControls"><t t-set="target" t-value="selected"/></t>
                                    <t t-call="report_studio.FontControls">
                                        <t t-set="font" t-value="selected.head_font"/><t t-set="title" t-value="fontTitles.head"/>
                                    </t>
                                    <t t-call="report_studio.FontControls">
                                        <t t-set="font" t-value="selected.body_font"/><t t-set="title" t-value="fontTitles.body"/>
                                    </t>
                                    <div class="d-flex align-items-baseline mt-3 mb-1">
                                        <span class="fw-bold me-auto">Columns</span>
                                        <small t-attf-class="o_rs_width_total {{ totalWidth(selected.columns) === 100 ? 'text-muted' : 'text-danger' }}">
                                            Total <t t-esc="totalWidth(selected.columns)"/>%
                                        </small>
                                    </div>
                                    <!-- One row per column: move, field, label, width, lock, alignment, remove. -->
                                    <div t-if="!relationOf(selected.source)" class="small text-warning mb-1 o_rs_source_first">
                                        <i class="fa fa-info-circle me-1"/>Choose the table source first: the column fields are the fields of its lines.
                                    </div>
                                    <div class="o_rs_column_grid o_rs_column_head small text-muted">
                                        <span/><span>Field</span><span>Label</span><span>Width %</span>
                                        <span title="Lock the width"><i class="fa fa-lock"/></span>
                                        <span title="Alignment"><i class="fa fa-align-left"/></span><span/>
                                    </div>
                                    <t t-foreach="selected.columns" t-as="col" t-key="col._uid">
                                        <div class="o_rs_column o_rs_column_grid mb-1" t-att-data-uid="col._uid">
                                            <div class="o_rs_col_move d-flex flex-column">
                                                <button type="button" class="btn btn-link p-0 lh-1 o_rs_col_up" title="Move the column left"
                                                        t-att-disabled="col_first" t-on-click="() => this.moveColumn(col._uid, -1)">
                                                    <i class="fa fa-caret-up"/>
                                                </button>
                                                <button type="button" class="btn btn-link p-0 lh-1 o_rs_col_down" title="Move the column right"
                                                        t-att-disabled="col_last" t-on-click="() => this.moveColumn(col._uid, 1)">
                                                    <i class="fa fa-caret-down"/>
                                                </button>
                                            </div>
                                            <FieldSelector value="col.path or ''" model="relationOf(selected.source)" loadFields="loadFields"
                                                           placeholder="relationOf(selected.source) ? columnFieldPlaceholder : sourceFirstPlaceholder" onChange="(v) => this.setPath(col, 'path', v)" class="'o_rs_path_column'"/>
                                            <input class="form-control form-control-sm o_rs_col_label"
                                                   t-att-placeholder="trPlaceholder(col, 'label', columnLabelPlaceholder) or columnLabelPlaceholder"
                                                   t-att-value="trValue(col, 'label')"
                                                   t-on-input="(ev) => this.setTr(col, 'label', ev)"/>
                                            <input type="number" min="1" max="100" step="1"
                                                   class="form-control form-control-sm o_rs_width_input"
                                                   t-att-value="col.width" t-att-disabled="col.locked"
                                                   t-on-change="(ev) => this.onColumnWidth(col._uid, ev)"/>
                                            <input type="checkbox" class="form-check-input o_rs_width_lock m-0"
                                                   title="Lock: it does not change when the other columns change"
                                                   t-att-checked="col.locked"
                                                   t-on-change="(ev) => this.onColumnLock(col._uid, ev)"/>
                                            <Dropdown menuClass="'o_rs_col_align_menu'">
                                                <button type="button"
                                                        t-attf-class="btn btn-sm btn-outline-secondary o_rs_col_align {{ col.align ? '' : 'o_rs_inherited' }}"
                                                        t-att-data-align="col.align or ''"
                                                        t-att-title="columnAlignTitle(col)">
                                                    <i t-attf-class="fa {{ alignIcon(col.align or tableAlign) }}"/>
                                                </button>
                                                <t t-set-slot="content">
                                                    <DropdownItem onSelected="() => this.setColumnAlign(col._uid, '')"
                                                                  class="col.align ? '' : 'active'" attrs="{'data-align': ''}">
                                                        <i t-attf-class="fa {{ alignIcon(tableAlign) }} fa-fw me-2 opacity-50"/>As the table
                                                    </DropdownItem>
                                                    <t t-foreach="alignments" t-as="al" t-key="al[0]">
                                                        <DropdownItem onSelected="() => this.setColumnAlign(col._uid, al[0])"
                                                                      class="col.align === al[0] ? 'active' : ''" attrs="{'data-align': al[0]}">
                                                            <i t-attf-class="fa {{ al[2] }} fa-fw me-2"/><t t-esc="al[1]"/>
                                                        </DropdownItem>
                                                    </t>
                                                </t>
                                            </Dropdown>
                                            <button class="btn btn-sm btn-outline-danger" t-att-data-uid="col._uid"
                                                    t-on-click="onRemoveColumn" title="Remove column">×</button>
                                        </div>
                                    </t>
                                    <button class="btn btn-sm btn-outline-primary" t-on-click="onAddColumn">+ column</button>
                                    <t t-call="report_studio.MarginControls"><t t-set="margins" t-value="selected.margins"/></t>
                                </t>

                                <t t-if="selected.type === 'if'">
                                    <label class="form-label">Field</label>
                                    <FieldSelector value="selected.path or ''" model="state.modelName" loadFields="loadFields"
                                                   onChange="(v) => this.setPath(selected, 'path', v)" class="'o_rs_path_if'"/>
                                    <label class="form-label mt-2">Operator</label>
                                    <select class="form-select" t-model="selected.op" t-on-change="markDirty">
                                        <option value="==">equal to</option>
                                        <option value="!=">different from</option>
                                        <option value=">">greater than</option>
                                        <option value="&lt;">less than</option>
                                        <option value=">=">greater or equal</option>
                                        <option value="&lt;=">less or equal</option>
                                    </select>
                                    <label class="form-label mt-2">Value</label>
                                    <input class="form-control" t-model="selected.value" t-on-input="markDirty"/>
                                </t>

                                <div class="small text-muted mt-3">
                                    Move, drag or delete the block with the bar above it in the page.
                                </div>
                                <div class="mt-2" t-if="selectedParentUid">
                                    <button class="btn btn-sm btn-link px-0" t-on-click="selectParent">↖ Select the container</button>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="text-muted">Select a block in the page to edit its properties.</div>
                                <div class="o_rs_props_title mt-4 mb-2">Page</div>
                                <div class="small text-muted mb-2">
                                    Main language of the texts: <b t-esc="langName(baseLang)"/>.
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input o_rs_print_lang" type="checkbox" id="o_rs_print_lang"
                                           t-att-checked="state.definition.print_lang?.enabled" t-on-change="onPrintLang"/>
                                    <label class="form-check-label" for="o_rs_print_lang">Print in the customer language</label>
                                </div>
                                <t t-if="state.definition.print_lang?.enabled">
                                    <label class="form-label small text-muted mt-2 mb-1">Language read from the contact</label>
                                    <select class="form-select form-select-sm o_rs_print_lang_field" t-on-change="onPrintLangField">
                                        <t t-foreach="partnerFields" t-as="pf" t-key="pf.name">
                                            <option t-att-value="pf.name" t-att-selected="pf.name === state.definition.print_lang.field">
                                                <t t-esc="pf.string"/> (<t t-esc="pf.name"/>)
                                            </option>
                                        </t>
                                    </select>
                                    <div class="small text-muted mt-1">
                                        Translated texts and Odoo fields (products, dates, selections) are printed in the language of the contact; when the contact has no language, in the one of the user printing.
                                    </div>
                                </t>
                                <div t-else="" class="small text-muted mt-1">
                                    Off: printed in the language of the user printing.
                                </div>
                            </t>
                        </t>
                    </div>
                </div>

            </t>
        </div>
    </t>

</templates>
