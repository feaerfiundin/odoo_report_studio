<odoo>
    <record id="view_users_form_report_studio" model="ir.ui.view">
        <field name="name">res.users.form.report_studio</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Report Studio" name="report_studio_access">
                    <group>
                        <field name="report_studio_role" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
