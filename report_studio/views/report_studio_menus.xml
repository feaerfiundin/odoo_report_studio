<odoo>
    <record id="action_report_studio_editor" model="ir.actions.client">
        <field name="name">Report Studio</field>
        <field name="tag">report_studio.editor</field>
    </record>

    <!-- Top level menu: base.menu_reporting does not exist in every installation.
         Visible to the Report Studio roles and to system administrators, who
         already have full access to reports (ACL) even without a Report Studio role. -->
    <menuitem
        id="menu_report_studio_root"
        name="Report Studio"
        action="action_rs_report_list"
        sequence="90"
        groups="report_studio.group_rs_viewer,base.group_system"
    />

    <menuitem
        id="menu_report_studio_layouts"
        name="Saved Layouts"
        parent="menu_report_studio_root"
        action="action_rs_report_list"
        sequence="10"
    />

    <!-- Reports: printing and Print menu of the reports
         (like Settings > Technical > Reports). -->
    <menuitem
        id="menu_report_studio_print"
        name="Reports"
        parent="menu_report_studio_root"
        action="action_rs_report_print"
        sequence="20"
    />

    <!-- Reusable blocks (custom content of the editor toolbox). -->
    <menuitem
        id="menu_report_studio_blocks"
        name="Reusable Blocks"
        parent="menu_report_studio_root"
        action="action_rs_block"
        sequence="30"
    />
</odoo>
