<odoo>
    <!-- Report Studio groups. The role of each user is chosen with the
         report_studio_role field (res.users), which sets the matching group. -->

    <!-- User: can print reports, no access to the designer. -->
    <record id="group_rs_user" model="res.groups">
        <field name="name">Report Studio / User</field>
    </record>

    <!-- Viewer: sees the designer, the history and the preview, without editing. -->
    <record id="group_rs_viewer" model="res.groups">
        <field name="name">Report Studio / Viewer</field>
        <field name="implied_ids" eval="[(4, ref('group_rs_user'))]" />
    </record>

    <!-- Editor: creates reports and new versions, restores earlier versions. -->
    <record id="group_rs_editor" model="res.groups">
        <field name="name">Report Studio / Editor</field>
        <field name="implied_ids" eval="[(4, ref('group_rs_viewer'))]" />
    </record>

    <!-- Administrator: manages the roles of the other users and edits free QWeb. -->
    <record id="group_rs_manager" model="res.groups">
        <field name="name">Report Studio / Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_rs_editor'))]" />
    </record>
</odoo>
